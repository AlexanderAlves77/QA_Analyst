{
  "Framework": {
    "Environment": "Development",
    "DefaultTimeoutSeconds": 30
  },
  "Logging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "FilePath": "logs/eaf-.json"
  },
  "Browser": {
    "Type": "Chrome",
    "Headless": false,
    "WindowWidth": 1920,
    "WindowHeight": 1080,
    "PageLoadTimeoutSeconds": 60,
    "ScriptTimeoutSeconds": 30,
    "ImplicitWaitSeconds": 0,
    "BinaryPath": null,
    "AdditionalArguments": []
  }
}